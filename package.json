{
  "name": "chromium-browser-pro",
  "productName": "Chromium Browser Pro",
  "version": "2.0.0",
  "description": "A fully usable, professional Chromium-based browser for Windows",
  "main": "main.js",
  "author": "Cline",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.cline.chromiumbrowserpro",
    "productName": "Chromium Browser Pro",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Chromium Browser Pro",
      "menuCategory": true
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  }
}
